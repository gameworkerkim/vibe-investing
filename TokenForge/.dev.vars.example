# 로컬 개발용 변수 예시. 복사해서 .dev.vars 로 저장 (커밋 금지).
# 없으면 mock 모드 + localStorage/KV 폴백으로 동작하므로 로컬 테스트는 키 없이 가능.

# DeepSeek (한국어/외국어 -> 영어 최적화 엔진)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 기억(Memory) 백엔드 — 옵션. 설정 시 KV 대신 사용.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEON_DATABASE_URL=
