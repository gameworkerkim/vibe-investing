# Cloudflare Pages CDN cache headers
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  X-DNS-Prefetch-Control: off
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Static API docs — rare changes; cache at edge + browser
/apis
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/apis.html
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/columns/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/tech/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/cti/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/cyworld/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=600

/essays/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/play/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/about/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  CDN-Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600, no-transform
  Content-Type: text/xml; charset=utf-8

/sitemaps/*.xml
  Cache-Control: public, max-age=3600, no-transform
  Content-Type: text/xml; charset=utf-8

/sitemaps/robots-*.txt
  Cache-Control: public, max-age=300, must-revalidate, no-transform
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=300, must-revalidate, no-transform
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600

# Bing / IndexNow ownership key (Option 1 — site root)
/c0a0370ed9aa475db8c5a70146ccd261.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/css/*
  Cache-Control: public, max-age=300, must-revalidate

/js/*
  Cache-Control: public, max-age=120, must-revalidate

# Landing page — keep fresh for deploys
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
