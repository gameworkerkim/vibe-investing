# VIBEQUANT DATA BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Neon PostgreSQL ──────────────────────────────────────
# Format: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# ── Upstash Redis ────────────────────────────────────────
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── TOSS Open API ────────────────────────────────────────
# Get from https://developers.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_PER_ROUTE=10
RATE_LIMIT_GLOBAL=100
CACHE_TTL_SECONDS=300
