# Local secrets for `wrangler dev` / deploy scripts.
# Copy via: ./scripts/setup-secrets.sh --local
# Never commit .dev.vars

# ── TOSS Open API (optional — skip for Yahoo-only) ───────
# https://developers.tossinvest.com
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# ── Cloudflare (deploy / wrangler non-interactive) ───────
# https://dash.cloudflare.com/profile/api-tokens
# Token needs (Account permissions):
#   Workers Scripts:Edit, Workers KV Storage:Edit (optional),
#   D1:Edit, Account Settings:Read,
#   Cloudflare Pages:Edit, Workers R2 Storage:Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
