{
  "name": "@vibe-investing/vibequant-cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup-secrets": "bash scripts/setup-secrets.sh --local",
    "setup-secrets:remote": "bash scripts/setup-secrets.sh --remote",
    "bootstrap": "bash scripts/bootstrap.sh",
    "deploy": "bash scripts/deploy.sh",
    "upload-static": "bash scripts/upload-static.sh",
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "bash -c 'cd ../pages && npx wrangler pages deploy . --project-name=vibequant-web --commit-dirty=true'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.112.0"
  }
}
