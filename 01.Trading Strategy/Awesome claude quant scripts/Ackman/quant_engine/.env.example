# python scripts/setup_credentials.py 실행 시 이 파일을 기반으로 .env가 생성됩니다.
# 값을 비워두면 각 클라이언트는 MOCK/제한 모드로 동작합니다 (로컬 테스트 가능).

# --- TOSS 증권 Open API (https://developers.tossinvest.com) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_BASE_URL=https://openapi.tossinvest.com

# --- DART Open API (https://opendart.fss.or.kr) — 국내 상장사 재무제표 ---
DART_API_KEY=

# --- DeepSeek LLM API (https://platform.deepseek.com) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 뉴스 (선택, 없으면 RSS 폴백) ---
NEWSAPI_KEY=

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ackman_quant

# --- 웹 대시보드(dashboard/app.py) 접속 게이트 키 ---
# http://127.0.0.1:8765/admin/setup/<이 값> 로만 접속 가능. 비워두면 최초 실행 시
# 자동 생성되어 .env에 저장되고 터미널에 접속 URL이 출력됩니다.
# scripts/setup_credentials.py 로만 설정 가능 (대시보드 폼에는 노출되지 않음).
ADMIN_SETUP_KEY=
