{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leaf",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "routes": [
    { "pattern": "vibequant.cc/Leaf*", "zone_name": "vibequant.cc" }
  ],

  "r2_buckets": [
    { "binding": "leaf_images", "bucket_name": "leaf-images" }
  ],

  "d1_databases": [
    {
      "binding": "leaf_db",
      "database_name": "leaf-db",
      "database_id": "955d61fc-8a44-48a0-b398-e86ea068d07f",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": { "enabled": true }
}
